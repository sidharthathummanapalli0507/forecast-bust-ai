# ============================================================
# ForecastBustAI — Environment Configuration
# Smart India Hackathon 2026 Prototype
# ============================================================
# AI-Based Forecast Bust Risk Estimation for Medium-Range Weather Forecasts
#
# Primary Weather Provider: Open-Meteo (Free, Keyless, Operational)
# Map Visualization: OpenStreetMap / Leaflet (Free, Keyless, Operational)
# ============================================================

# ---- Operational Weather Provider (Open-Meteo - Free, No API Key Required) ----
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ---- Application & Runtime Configuration ----
APP_ENV=development
APP_PORT=3000
PORT=8001
FORECAST_DAYS=10
HISTORICAL_YEARS=5

# ---- Optional Future IMD Integration (Not required for operational prototype) ----
# IMD_API_KEY=
# IMD_BASE_URL=https://api.imd.gov.in
